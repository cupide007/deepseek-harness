{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "DeepSeek Harness desktop launcher: Electron window over an isolated local dsh web host",
  "version": "0.1.0-rc.7",
  "desktopName": "ai.deepseek.dsh.desktop",
  "homepage": "https://github.com/cupide007/deepseek-harness",
  "private": true,
  "type": "module",
  "main": "lib/main.js",
  "license": "MIT",
  "scripts": {
    "package": "electron-builder --publish never"
  },
  "build": {
    "appId": "ai.deepseek.dsh",
    "productName": "DeepSeek Harness",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "lib/**",
      "node_modules/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "executableName": "deepseek-harness",
      "maintainer": "DeepSeek Harness",
      "syncDesktopName": true
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh": "workspace:^"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  }
}
